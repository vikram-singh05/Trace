# ─────────────────────────────────────────────────────────────────
#  CampusFind — Environment Variables Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── SERVER (/server/.env) ─────────────────────────────────────────

# PostgreSQL — get from Supabase → Settings → Database → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT — generate a long random string (e.g. openssl rand -base64 64)
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Client origin (for CORS)
CLIENT_URL="http://localhost:5173"

# ImageKit — get from imagekit.io → Developer Options → API Keys
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/YOUR_IMAGEKIT_ID"

# Email — Gmail SMTP. SMTP_PASS must be a Gmail App Password (not your normal
# login password): Google Account → Security → App passwords.
# SMTP_USER/SMTP_PASS are optional — if omitted, emails are logged to the
# console instead of being sent (see server/src/utils/mailer.ts).
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="Trace <noreply@trace.app>"

# ── CLIENT (/client/.env) ─────────────────────────────────────────

# Vite exposes only variables prefixed with VITE_
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_SOCKET_URL="http://localhost:5000"
